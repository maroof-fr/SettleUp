{
  "info": {
    "name": "SettleUp API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Register (or Login) first: it saves the JWT in {{token}}. Then Add friend, Create debt."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "friendId",
      "value": ""
    },
    {
      "key": "debtId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('has token', () => pm.expect(j.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('has token', () => pm.expect(j.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Friends",
      "item": [
        {
          "name": "Add friend",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/friends",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "friends"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('friendId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List friends",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friends",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "friends"
              ]
            }
          }
        },
        {
          "name": "Remove friend",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friends/{{friendId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "friends",
                "{{friendId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Debts",
      "item": [
        {
          "name": "Create debt (Rs 1,000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/debts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"friendId\": \"{{friendId}}\",\n  \"direction\": \"LENT\",\n  \"amountPaise\": 100000,\n  \"description\": \"Trip share\",\n  \"date\": \"2026-10-01\",\n  \"dueDate\": \"2026-11-01\",\n  \"notes\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('debtId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List debts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts"
              ]
            }
          }
        },
        {
          "name": "Get debt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debts/{{debtId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts",
                "{{debtId}}"
              ]
            }
          }
        },
        {
          "name": "Update debt",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/debts/{{debtId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts",
                "{{debtId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"friendId\": \"{{friendId}}\",\n  \"direction\": \"LENT\",\n  \"amountPaise\": 100000,\n  \"description\": \"Trip share (edited)\",\n  \"date\": \"2026-10-01\",\n  \"dueDate\": \"2026-11-01\",\n  \"notes\": \"\"\n}"
            }
          }
        },
        {
          "name": "Delete debt",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debts/{{debtId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts",
                "{{debtId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments and balances",
      "item": [
        {
          "name": "Repay Rs 300",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/debts/{{debtId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts",
                "{{debtId}}",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 30000,\n  \"date\": \"2026-10-05\",\n  \"note\": \"UPI\"\n}"
            }
          }
        },
        {
          "name": "Overpay (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/debts/{{debtId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts",
                "{{debtId}}",
                "payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountPaise\": 999999999,\n  \"date\": \"2026-10-05\",\n  \"note\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('overpayment rejected', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/debts/{{debtId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debts",
                "{{debtId}}",
                "payments"
              ]
            }
          }
        },
        {
          "name": "Balances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/balances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "balances"
              ]
            }
          }
        }
      ]
    }
  ]
}